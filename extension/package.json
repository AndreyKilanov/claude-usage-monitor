{
  "name": "claude-usage-monitor",
  "displayName": "Claude Usage Monitor — Limits & Tokens",
  "description": "Claude Code 5-hour and weekly limits, tokens by day, model and project, alerts and a pace forecast in the status bar. Unofficial. Русский / English.",
  "version": "0.6.5",
  "publisher": "andreykilanov",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "usage",
    "limits",
    "rate limit",
    "quota",
    "tokens",
    "token usage",
    "status bar",
    "monitor",
    "antigravity",
    "cursor",
    "лимиты",
    "токены"
  ],
  "galleryBanner": {
    "color": "#24202a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.open",
        "title": "%command.open.title%"
      },
      {
        "command": "claudeUsage.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "claudeUsage.exportCsv",
        "title": "%command.exportCsv.title%"
      },
      {
        "command": "claudeUsage.setup",
        "title": "%command.setup.title%"
      },
      {
        "command": "claudeUsage.menu",
        "title": "%command.menu.title%"
      },
      {
        "command": "claudeUsage.openDataFolder",
        "title": "%command.openDataFolder.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "claudeUsage.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "claudeUsage.showFiveHour": {
          "type": "boolean",
          "default": true,
          "description": "%config.showFiveHour.description%"
        },
        "claudeUsage.showWeek": {
          "type": "boolean",
          "default": true,
          "description": "%config.showWeek.description%"
        },
        "claudeUsage.showToday": {
          "type": "boolean",
          "default": true,
          "description": "%config.showToday.description%"
        },
        "claudeUsage.showResetTimer": {
          "type": "boolean",
          "default": false,
          "description": "%config.showResetTimer.description%"
        },
        "claudeUsage.warnAt": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 99,
          "description": "%config.warnAt.description%"
        },
        "claudeUsage.critAt": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.critAt.description%"
        },
        "claudeUsage.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications.description%"
        },
        "claudeUsage.notifyOnReset": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOnReset.description%"
        },
        "claudeUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "%config.refreshIntervalSeconds.description%"
        },
        "claudeUsage.syncFolder": {
          "type": "string",
          "default": "",
          "description": "%config.syncFolder.description%"
        },
        "claudeUsage.csvDelimiter": {
          "type": "string",
          "enum": [
            "auto",
            ",",
            ";",
            "tab"
          ],
          "default": "auto",
          "description": "%config.csvDelimiter.description%"
        },
        "claudeUsage.numberGrouping": {
          "type": "string",
          "enum": [
            "auto",
            "space",
            "dot",
            "comma",
            "none"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.numberGrouping.enum.0%",
            "%config.numberGrouping.enum.1%",
            "%config.numberGrouping.enum.2%",
            "%config.numberGrouping.enum.3%",
            "%config.numberGrouping.enum.4%"
          ],
          "description": "%config.numberGrouping.description%"
        },
        "claudeUsage.clickAction": {
          "type": "string",
          "enum": [
            "menu",
            "panel"
          ],
          "default": "menu",
          "enumDescriptions": [
            "%config.clickAction.enum.0%",
            "%config.clickAction.enum.1%"
          ],
          "description": "%config.clickAction.description%"
        },
        "claudeUsage.offerPluginInstall": {
          "type": "boolean",
          "default": true,
          "description": "%config.offerPluginInstall.description%"
        }
      }
    }
  },
  "author": {
    "name": "Andrey Kilanov",
    "url": "https://github.com/AndreyKilanov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreyKilanov/claude-usage-monitor.git"
  },
  "homepage": "https://github.com/AndreyKilanov/claude-usage-monitor#readme",
  "bugs": {
    "url": "https://github.com/AndreyKilanov/claude-usage-monitor/issues"
  }
}
